<button type="button" onClick={() => setMoreOpen((value) => !value)} className="press mb-3 flex w-full items-center gap-3 rounded-xl border border-border bg-surface-2 px-3 py-3 text-left"><span className="grid size-8 place-items-center rounded-xl bg-surface text-primary"><MoreHorizontal size={15} /></span><span className="min-w-0 flex-1"><b className="block text-xs">More options</b><span className="block text-[10px] text-muted-foreground">Personal items, some people, charges, multiple payers</span></span><ChevronDown size={15} className={`transition-transform ${moreOpen ? 'rotate-180' : ''}`} /></button>{moreOpen ? <div className="mb-3 grid grid-cols-2 gap-2"><button type="button" onClick={() => setPersonalOpen(true)} className={`press rounded-xl border px-3 py-3 text-left text-[11px] font-bold ${personalItems.length ? 'border-primary/20 bg-secondary text-primary' : 'border-border bg-surface'}`}><span className="mr-1">👤</span> Personal items{personalItems.length ? ` · ${personalItems.length}` : ''}</button><button type="button" onClick={() => setSelectiveOpen(true)} className={`press rounded-xl border px-3 py-3 text-left text-[11px] font-bold ${selectiveItems.length ? 'border-primary/20 bg-secondary text-primary' : 'border-border bg-surface'}`}><span className="mr-1">👥</span> Some people{selectiveItems.length ? ` · ${selectiveItems.length}` : ''}</button><button type="button" onClick={() => { if (!charges.length) setCharges([{ id: uid(), description: '', amount: 0, distribution: 'equal' }]); setChargesOpen(true); }} className={`press rounded-xl border px-3 py-3 text-left text-[11px] font-bold ${charges.length ? 'border-primary/20 bg-secondary text-primary' : 'border-border bg-surface'}`}><span className="mr-1">🧾</span> Charges{charges.length ? ` · ${charges.length}` : ''}</button><button type="button" onClick={openMultiplePayers} className={`press rounded-xl border px-3 py-3 text-left text-[11px] font-bold ${multiPayer ? 'border-primary/20 bg-secondary text-primary' : 'border-border bg-surface'}`}><span className="mr-1">💳</span> {multiPayer ? 'Manage payers' : 'Multiple payers'}</button></div> : null}